# Configuration for the Docker stack (docker-compose.yml at the repo root).
#
#   cp .env.example .env
#
# The values below run the stack locally as-is. Everything marked CHANGE must get a
# real value before this reaches a server.
#
# Local development without Docker reads apps/directus/.env and
# apps/front/.env.local instead — see the README.
#
# Not everything about a deployment lives here: the compose SERVICE NAMES
# (regionaljournal-postgres/-directus/-front in docker-compose.yml) must stay unique
# across the whole deploy host, not just within this file - see the comment at the
# top of docker-compose.yml for why a shared-host PaaS (Dokploy, Coolify, Caprover)
# makes that load-bearing, not cosmetic.

####################################################################################
## Claude API — the only language model in this stack.
## No key: the app runs, AI features return an error. https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

####################################################################################
## SRGSSR Audio Metadata API — resolves a dossier story to its SRF audio episode.
## No key: dossier processing fails per-segment (resolution_error is recorded),
## it does not crash the app. See extensions/app/src/dossiers/srgssr-client.ts.
SRGSSR_CLIENT_ID=
SRGSSR_CLIENT_SECRET=
SRGSSR_SHOW_ID=

####################################################################################
## Mailbox polled by dossiers-ingest-imap for new dossier PDFs. Not final yet —
## see extensions/app/src/operations/dossiers-ingest-imap/mailbox.ts.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SUBJECT_FILTER=

####################################################################################################
## Punkt6 (Tele Basel) dossier mail — same mailbox/credentials as above, a second, independent
## subject filter. No SRGSSR-style credentials needed: extensions/app/src/punkt6/telebasel-client.ts
## resolves video/segments from telebasel.ch's own public, unauthenticated pages.
PUNKT6_IMAP_SUBJECT_FILTER=

####################################################################################
## Directus admin, created on first boot of an empty database.
## CHANGE both before deploying. A production deployment that keeps the line below
## unchanged accepts the same login as every other deployment of this app.
ADMIN_EMAIL=admin@wepublish.ch
ADMIN_PASSWORD=admin123

####################################################################################
## Secrets — CHANGE both before deploying, and use a fresh pair per deployment:
##
##   printf 'KEY=%s\nSECRET=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)"
##
## SECRET signs the access tokens. Two deployments that share it silently accept each
## other's tokens; two that differ reject them with `403 INVALID_TOKEN`. Neither is
## the failure you want to debug - keep them distinct, same as the service names.
KEY=59ccea19-23112-4a08-8sw72-dd2312341412
SECRET=1234

####################################################################################
## Database — CHANGE the password before deploying
DB_DATABASE=directus
DB_USER=postgres
DB_PASSWORD=password

####################################################################################
## Public URLs. Behind a reverse proxy, set these to the real https:// addresses —
## Directus uses them for CORS, for the invite/reset link allow-lists and for the
## links in its own emails.
DIRECTUS_PUBLIC_URL=http://localhost:8155
FRONT_PUBLIC_URL=http://localhost:3100

####################################################################################
## Host ports (local dev only - see docker-compose.override.yml). Change if
## 3100/8155 are already taken.
FRONT_PORT=3100
DIRECTUS_PORT=8155

####################################################################################
## Timezone for scheduled Flows (cron triggers fire in this zone).
TZ=Europe/Zurich

####################################################################################
## Set to false to boot without applying apps/directus/schema on start.
RUN_SCHEMA_SYNC=true
